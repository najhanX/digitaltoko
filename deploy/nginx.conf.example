# Adjust root and PHP-FPM socket for this VPS. Add TLS at Nginx or your trusted edge.
# This single origin also receives verified custom hostnames; Laravel rejects unknown hosts.
server {
    listen 80;
    server_name _;
    root /var/www/digitaltoko/apps/web/public;
    index index.php;
    charset utf-8;
    client_max_body_size 12m;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }
    location ~ ^/index\.php(/|$) {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_hide_header X-Powered-By;
    }
    location ~ \.php$ { return 404; }
    location ~ /\.(?!well-known).* { deny all; }
}
