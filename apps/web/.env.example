APP_NAME=DigitalToko
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Empty derives the root domain from APP_URL. No scheme, paths, or wildcard.
PLATFORM_DOMAIN=
PLATFORM_DOMAIN_ALIASES=
PLATFORM_PREVIEW_ENABLED=false
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
REDIS_QUEUE_RETRY_AFTER=240

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-to-server identity integration. Token must match DIGITALTOKO_IDENTITY_TOKEN in API Hanshop.
HANSHOP_API_URL=
HANSHOP_IDENTITY_TOKEN=

SUPPLIER_CACHE_STORE=redis
# Saldo dan Hanshop: 60-180 detik. Katalog Digiflazz memakai 300 detik sesuai batas pemasok.
SUPPLIER_CACHE_SECONDS=120
SUPPLIER_MAX_SNAPSHOT_AGE=600
DIGIFLAZZ_OUTBOUND_IP=
DIGIFLAZZ_WEBHOOK_URL=

# Same private token as apps/bot/.env. Manager is loopback only.
BOT_MANAGER_URL=http://127.0.0.1:3099
BOT_MANAGER_TOKEN=

# Enable only after reviewing digitaltoko:retention previews and backup policy.
STORE_PURGE_ENABLED=false

# Public outbound IP used by supplier connections; displayed in tenant connection dialogs.
SUPPLIER_OUTBOUND_IP=

# Custom storefront domains: optional stable CNAME target, public origin IPs, private TLS ask key (32+ chars).
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_ORIGIN_IPS=
CUSTOM_DOMAIN_TLS_ASK_KEY=

# Optional absolute release paths. Empty values use storage/app/releases/ defaults.
HANSDEV_FORWARDER_APK_PATH=
HANSDEV_FORWARDER_TOOLS_WINDOWS_PATH=
HANSDEV_FORWARDER_TOOLS_MACOS_PATH=
HANSDEV_FORWARDER_TOOLS_LINUX_PATH=

# Encrypted backups (dedicated random key; keep a separate offline copy).
BACKUP_ENABLED=false
BACKUP_KEY=
BACKUP_TIME=03:00
BACKUP_KEEP=7
BACKUP_MAX_AGE_HOURS=30
# Absolute paths; backup/replica must be outside media and sessions.
BACKUP_DIRECTORY=
BACKUP_REPLICA_DIRECTORY=
BACKUP_MYSQLDUMP=mysqldump
BACKUP_MYSQL=mysql
# Override if apps/bot SESSION_ROOT differs from its default.
BACKUP_BOT_SESSIONS=
