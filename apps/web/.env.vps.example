APP_NAME=DigitalToko
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hansdigi.biz.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
PLATFORM_DOMAIN=hansdigi.biz.id
PLATFORM_DOMAIN_ALIASES=
PLATFORM_PREVIEW_ENABLED=false
TRUSTED_PROXIES=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digitaltoko
DB_USERNAME=digitaltoko
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_COOKIE=digitaltoko_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
CACHE_PREFIX=digitaltoko_cache_
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=2
REDIS_CACHE_DB=3
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
LOG_CHANNEL=stack
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.hansdigi.biz.id
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@hansdigi.biz.id
MAIL_FROM_NAME=DigitalToko

# Server-to-server identity integration. Use HTTPS or a private network in production.
HANSHOP_API_URL=
HANSHOP_IDENTITY_TOKEN=

BOT_MANAGER_URL=http://127.0.0.1:3099
BOT_MANAGER_TOKEN=

# Keep cookies isolated per hostname (do not use .hansdigi.biz.id).
SESSION_DOMAIN=null
FILESYSTEM_DISK=local

SUPPLIER_CACHE_STORE=redis
SUPPLIER_CACHE_SECONDS=120
SUPPLIER_MAX_SNAPSHOT_AGE=600
SUPPLIER_OUTBOUND_IP=
DIGIFLAZZ_OUTBOUND_IP=
DIGIFLAZZ_WEBHOOK_URL=
CUSTOM_DOMAIN_CNAME_TARGET=shops.hansdigi.biz.id
CUSTOM_DOMAIN_ORIGIN_IPS=
CUSTOM_DOMAIN_TLS_ASK_KEY=
STORE_PURGE_ENABLED=false

# First installation only: ProductionSeeder requires a real admin password.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Enable scheduled backups after testing a manual backup and securing the key.
BACKUP_ENABLED=false
BACKUP_KEY=
BACKUP_TIME=03:00
BACKUP_KEEP=7
BACKUP_MAX_AGE_HOURS=30
BACKUP_UPLOAD_MAX_MB=512
BACKUP_DIRECTORY=/home/hans/backups/digitaltoko
BACKUP_REPLICA_DIRECTORY=
BACKUP_BOT_SESSIONS=/home/hans/hanshop/digitaltoko/apps/bot/sessions
BACKUP_MYSQLDUMP=/usr/bin/mysqldump
BACKUP_MYSQL=/usr/bin/mysql
BACKUP_LIVE_RESTORE_ENABLED=false
# Absolute paths from: npm root -g / command -v node (adjust for NVM if used).
BACKUP_PM2_CLI=
BACKUP_NODE_BINARY=/usr/bin/node

# Optional release files for the public download/tutorial pages.
HANSDEV_FORWARDER_APK_PATH=
HANSDEV_FORWARDER_TOOLS_WINDOWS_PATH=
HANSDEV_FORWARDER_TOOLS_MACOS_PATH=
HANSDEV_FORWARDER_TOOLS_LINUX_PATH=
