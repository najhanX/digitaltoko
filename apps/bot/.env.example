# One worker process per store. No production credentials are supplied here.
STORE_ID=
WORKER_TOKEN=
WEB_BASE_URL=http://localhost:8000
PORT=3100
SESSION_ROOT=./sessions
WA_ENABLED=false
LOG_LEVEL=info

# Managed multi-store mode: npm run manager:dev (or build + npm run manager).
# Match BOT_MANAGER_TOKEN in apps/web/.env; never use the Hanshop bot token.
BOT_MANAGER_TOKEN=
MANAGER_PORT=3099
MANAGER_MAX_WORKERS=100
# Manual worker only: BOT_PHONE=6281234567890, PAIRING_METHOD=qr or code.
